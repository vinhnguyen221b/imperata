{
  "permissions": {
    "deny": [
      "Bash(gh pr merge)",
      "Bash(gh pr merge *)",
      "Bash(gh pr review *)",
      "Bash(git push --force *)",
      "Bash(git push * --force)",
      "Bash(git push * --force *)",
      "Bash(git push --force-with-lease *)",
      "Bash(git push * --force-with-lease)",
      "Bash(git push * --force-with-lease *)",
      "Bash(git push --force-with-lease=*)",
      "Bash(git push * --force-with-lease=*)",
      "Bash(git push --mirror *)",
      "Bash(git push * --mirror)",
      "Bash(git push * --mirror *)",
      "Bash(git push -f *)",
      "Bash(git push * -f)",
      "Bash(git push * -f *)",
      "Bash(git push * +*)",
      "Edit(./sdlc/runs/*/decisions/**)",
      "Read(**/.env)",
      "Read(**/.env.*)"
    ],
    "ask": [
      "Bash(git push)",
      "Bash(git push *)",
      "Bash(gh pr create *)",
      "Bash(gh pr ready *)",
      "Bash(gh pr close *)",
      "Bash(gh pr edit *)",
      "Bash(gh issue *)",
      "Bash(gh api *)",
      "Edit(./.claude/**)",
      "Edit(./scripts/validate-gates.mjs)",
      "Edit(./scripts/render-run-board.mjs)",
      "Edit(./scripts/board-server.mjs)",
      "Edit(./scripts/record-run.mjs)",
      "Edit(./scripts/lock-tests.mjs)",
      "Edit(./.github/workflows/**)",
      "Edit(./.orchestra/auto-run.json)",
      "Edit(./.orchestra/installed.json)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|MultiEdit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/owner-decisions-guard.mjs\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|MultiEdit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/validate-run-manifest.mjs\""
          },
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/render-run-board.mjs\""
          }
        ]
      }
    ]
  }
}
